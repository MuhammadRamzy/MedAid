# QIDMA Medical Aid — environment reference
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
# The same variables must be added to the Vercel project settings for deployment.

# ---------------------------------------------------------------------------
# Firebase client SDK — used ONLY for signInWithEmailAndPassword in the browser.
# These are public by design (they ship in the JS bundle). Security comes from
# Firestore rules denying all client access, not from hiding these values.
#
# Where: Firebase console > Project settings > General > Your apps > Web app > SDK setup
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK — server-side only. SECRET. Grants full database access,
# bypassing all security rules. Never prefix these with NEXT_PUBLIC_.
#
# Where: Firebase console > Project settings > Service accounts >
#        Generate new private key (downloads a JSON file)
#
# FIREBASE_PRIVATE_KEY: copy the "private_key" value from that JSON, keeping the
# surrounding double quotes and the literal \n sequences exactly as they appear.
# Example: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Application
# Local: http://localhost:3000   Production: the deployed Vercel URL
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# First administrator bootstrap — read by scripts/bootstrap-admin.ts only.
# Email/PIN accounts still need an admin to exist before one can create the
# next, so the very first one is made by this script. Run it once, then
# clear these values. BOOTSTRAP_ADMIN_PIN is optional — 6 digits, or leave
# blank and the script generates one and prints it.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_ADMIN_PIN=
